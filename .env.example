# ============================================================================
# CAMO Media — Environment Variables
# Copy this file to `.env.local` and fill in real values. NEVER commit secrets.
# ============================================================================

# ---------------------------------------------------------------------------
# Convex (backend / database / file storage)
# ---------------------------------------------------------------------------
# Public deployment URL — safe to expose to the browser. Created by `npx convex dev`.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# ---------------------------------------------------------------------------
# Clerk (authentication)
# ---------------------------------------------------------------------------
# Publishable key — safe to expose to the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Secret key — SERVER ONLY. Never expose to the client.
CLERK_SECRET_KEY=sk_test_xxx

# The Clerk JWT issuer domain (Frontend API URL, e.g. https://your-app.clerk.accounts.dev).
# Used by Convex auth.config.ts to validate Clerk-issued JWTs.
# Find it in Clerk Dashboard -> JWT Templates -> "convex" template, or API Keys.
NEXT_PUBLIC_CLERK_FRONTEND_API_URL=https://your-app.clerk.accounts.dev

# Where Clerk redirects for sign in / up.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/admin

# ---------------------------------------------------------------------------
# Admin authorization
# ---------------------------------------------------------------------------
# Comma-separated list of admin email addresses that may access /admin and run
# protected Convex mutations. This is read BOTH by Next.js middleware and, more
# importantly, set as a Convex environment variable so the backend can enforce it.
# In Convex: `npx convex env set ADMIN_EMAILS "you@example.com,team@example.com"`
ADMIN_EMAILS=you@example.com

# ---------------------------------------------------------------------------
# Google Analytics 4 (PLACEHOLDER — not wired up yet)
# ---------------------------------------------------------------------------
# Public Measurement ID for client-side GA4 tag (gtag.js). Safe to expose.
# TODO: Add the GA4 <Script> tag once you have this ID.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Google Analytics Data API (server-only — for the admin Analytics dashboard).
# TODO: These power real "Visitors today" etc. via @google-analytics/data.
# NEVER expose these to the browser. Read them only in Convex actions / server routes.
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
